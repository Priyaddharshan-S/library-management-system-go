# Copy this file to .env and adjust if needed.
# When running via `docker compose up`, these values are already baked into
# docker-compose.yml for the api service, so this file is mainly useful if
# you ever want to run the Go binary directly on your PC (outside Docker).

PORT=8080

# Inside Docker, the database host is "db" (the service name in docker-compose.yml).
# If you run the API directly on your PC (not in Docker), change "db" to "localhost".
DATABASE_URL=postgres://library_user:library_pass@db:5432/library_db?sslmode=disable

JWT_SECRET=change_this_to_a_long_random_string
